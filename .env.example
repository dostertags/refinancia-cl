# Copia a .env y ajusta. NUNCA subas .env al repositorio.

# --- Base de datos / caché ---
POSTGRES_PASSWORD=cambia-esta-clave-larga        # obligatoria en docker compose
DATABASE_URL=sqlite:///./refinancia.db           # en producción: postgresql+psycopg2://usuario:clave@host:5432/refinancia
REDIS_URL=                                       # opcional (caché de ofertas)

# --- API ---
CORS_ORIGINS=http://localhost:3000               # orígenes permitidos, separados por coma
PUBLIC_URL=http://localhost:3000                 # URL que abre el QR del PDF (no contiene datos del usuario)
FORCE_HTTPS=0                                    # 1 en producción detrás de un proxy TLS (redirige y envía HSTS)
RATE_LIMIT_PER_MIN=30                            # solicitudes por IP por minuto
SOLVER_TIME_LIMIT_S=8                            # tope de tiempo del optimizador
ADMIN_TOKEN=                                     # vacío = endpoint de scraping deshabilitado. Usa un valor largo y aleatorio

# --- Reglas de negocio (criterios de la herramienta; TODO: verificar con abogado) ---
TOPE_ENDEUDAMIENTO_VECES_RENTA=10
TOPE_CUOTA_PCT_RENTA=0.25
MESES_MAX_TARJETA=24
PLAZO_MAX_CONSUMO_MESES=60

# --- Scraper SERNAC ---
MAX_EDAD_OFERTAS_DIAS=3
MIN_HORAS_ENTRE_SCRAPES=20
SCRAPER_USER_AGENT=RefinanciaCL-bot/0.1 (+https://github.com/TU-USUARIO/refinanciacl; contacto@tu-dominio.cl)

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
